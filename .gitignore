# Unreal Engine - generated/local directories
Intermediate/
Saved/
DerivedDataCache/
Binaries/

# Also ignore the same folders inside any plugin
Plugins/*/Intermediate/
Plugins/*/Binaries/

# Visual Studio
.vs/
*.user
*.suo
*.opensdf
*.sdf

# Rider
.idea/

# Compiled object files
*.obj
*.pch

# Compiled VS project files (regenerated by UE)
*.vcxproj
*.vcxproj.filters
*.sln

# Crash dumps
*.dmp
